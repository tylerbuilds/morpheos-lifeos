# Copy to .env; start with: node --env-file=.env server.mjs
HOST=127.0.0.1
PORT=3000
LIFEOS_DATA_DIR=./data
# Required for a network interface or a configured HTTPS origin (12–512 characters).
# LIFEOS_PASSWORD=
# Required behind an HTTPS reverse proxy. Do not include a path.
# LIFEOS_ORIGIN=https://life.example.com
# Optional read-only directory of YYYY-MM-DD - Title.md journal files.
# LIFEOS_JOURNAL_DIR=/path/to/your/vault/Journal/Weekly
